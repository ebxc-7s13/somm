# SOMM — environment configuration. Copy to `.env` and fill in what you need.
# Every value here is a placeholder. Never commit a real `.env`.
# SOMM runs without any provider credentials: CSV / text / M3U / XSPF / JSON
# imports and manual song entry always work. Provider imports show an honest
# "needs credentials" state until configured.

# --- Server -----------------------------------------------------------------
PORT=8787
# Public origin the browser uses (Vite dev server in development).
# On Render this defaults to the service's own https URL when left empty.
PUBLIC_URL=http://127.0.0.1:5173

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string (e.g. a free Neon database). Keep it secret.
# Example shape only: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Leave empty to use PGlite: an embedded Postgres stored in PGLITE_DATA_DIR,
# which needs no installation (local development and tests).
DATABASE_URL=
PGLITE_DATA_DIR=./data/pglite
# Max pooled connections when DATABASE_URL is set.
DATABASE_POOL_MAX=5
# Trust the first X-Forwarded-For hop for client IPs (rate limits). Automatic on Render.
TRUST_PROXY=false

# 32 random bytes, base64. Encrypts provider OAuth tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Allow the one-click temporary demo account (expires after 24 hours).
DEMO_MODE_ENABLED=true
# Seed the fictional demo listeners and Trees on start (idempotent). Or run `npm run seed:demo`.
SEED_DEMO_ON_START=false
# Bind address. Use 0.0.0.0 inside containers.
HOST=127.0.0.1
# Comma-separated handles allowed to review reports across all Trees.
ADMIN_HANDLES=

# --- Metadata enrichment ----------------------------------------------------
# MusicBrainz requires a User-Agent with a way to contact the maintainer.
# Enrichment stays disabled until MUSICBRAINZ_CONTACT is set (email or URL).
MUSICBRAINZ_ENABLED=true
MUSICBRAINZ_CONTACT=
# Apple iTunes Search API (public, ~20 calls/minute). Used only for primary genre
# lookups with a link back to the store. Off by default; read docs/MUSIC_IMPORTS.md.
ITUNES_LOOKUP_ENABLED=false

# --- Spotify (OAuth Authorization Code + PKCE; no client secret needed) -----
# Development-mode apps: owner needs Premium, max 5 allow-listed users,
# playlist items only for playlists the user owns or collaborates on.
SPOTIFY_CLIENT_ID=
# Must exactly match the app settings. Spotify requires a loopback IP literal
# (127.0.0.1) instead of "localhost" for local redirect URIs.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/api/providers/spotify/callback

# --- YouTube Data API v3 (API key → public/unlisted playlists only) ---------
YOUTUBE_API_KEY=

# --- Apple Music API (requires paid Apple Developer Program membership) -----
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Path to the MusicKit .p8 private key file. Keep it outside the repository.
APPLE_MUSIC_PRIVATE_KEY_PATH=

# --- Calls (WebRTC 1:1, optional) -------------------------------------------
CALLS_ENABLED=true
STUN_URLS=stun:stun.cloudflare.com:3478
# Optional static TURN relay (needed for many mobile / corporate networks).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Matching (optional override; JSON) -------------------------------------
# MATCH_WEIGHTS={"tracks":0.40,"artists":0.25,"genres":0.20,"attributes":0.15,"text":0}
